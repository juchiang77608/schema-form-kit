{
  "name": "schema-form-kit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @schema-form-kit/playground dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.12.3",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
