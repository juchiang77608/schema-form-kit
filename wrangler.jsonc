// Cloudflare Workers (static assets) — deploys the playground.
// Workers Builds runs the build command, then `npx wrangler deploy` reads this file.
// "name" must match the Worker name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schema-form-kit",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/playground/dist",
    "not_found_handling": "single-page-application",
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches (PR preview URLs).
  "previews": {},
}
